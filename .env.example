# Fill locally. Never commit .env. Use the provider's exact model ID.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=60
# Match this to the documented context window of your chosen model.
LLM_CONTEXT_WINDOW_TOKENS=8192
RAG_MAX_CONTEXT_TOKENS=3000
# Some providers require max_completion_tokens instead of max_tokens.
LLM_OUTPUT_TOKEN_PARAMETER=max_tokens
# Optional provider extension; leave empty for a generic compatible API.
LLM_THINKING=
# DeepSeek aliases are accepted instead of the corresponding LLM_* keys.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_TIMEOUT_SECONDS=90
# DEEPSEEK_MAX_TOKENS=1024
# DEEPSEEK_THINKING=disabled
